PROJECT_NAME="PharmaLink Enterprise API"
PROJECT_VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Security & JWT
# Generate a strong 32+ character secret for production (e.g. openssl rand -hex 32)
SECRET_KEY="replace-with-a-strong-random-32-plus-character-secret"
ACCESS_TOKEN_EXPIRE_MINUTES=15
ALGORITHM="HS256"

# CORS Configuration (JSON array string or comma separated origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database URL
DATABASE_URL="sqlite:///./pharmalink.db"

# Razorpay Payment Gateway Credentials (Rotate in Production Dashboard)
RAZORPAY_KEY_ID="rzp_test_placeholder_key_id"
RAZORPAY_KEY_SECRET="placeholder_razorpay_secret_key"
RAZORPAY_ENABLED=true
RAZORPAY_MODE="test"

# SMTP Email Gateway Credentials
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-google-app-password"
SENDER_EMAIL="orders@yourdomain.com"
SENDER_NAME="PharmaLink Enterprise"
EMAIL_ENABLED=true

# SMS Gateway Credentials (Twilio / Fast2SMS)
SMS_PROVIDER="Fast2SMS" # Fast2SMS | Twilio | AWS SNS | Mock Gateway Simulator
SMS_API_KEY="your_fast2sms_api_key_or_twilio_auth_token"
SMS_SENDER_ID="PHARMA"
SMS_ENABLED=true

